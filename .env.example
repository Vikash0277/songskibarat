# ─────────────────────────────────────────────────────────────
# Cyber Café Radio — environment variables
# Copy this file to `.env` and fill in real values.
# ─────────────────────────────────────────────────────────────

# MongoDB Atlas (direct connection — no SRV needed)
MONGODB_URI=mongodb://USER:PASS@host1:27017,host2:27017,host3:27017/DBNAME?retryWrites=true&w=majority&authSource=admin&tls=true
JWT_SECRET=replace-with-a-long-random-secret

# YouTube playlists (YouTube Data API v3)
YOUTUBE_DATA_API_KEY=

# Rate limiting (Upstash Redis, optional but recommended)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
